# Summary through OpenRouter (defaults shown). Set the key, or a Proton Pass
# reference that pass-cli resolves at summary time.
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_REF=pass://<vault>/<item>/<field>
# SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Recording.
# MEETING_LANGUAGE=en
# MEETREC_BIN=

# Transcription (speech CLI: MOSS on MLX).
# SPEECH_BIN=
# SPEECH_MODEL=int5
# SPEECH_BACKEND=mlx
