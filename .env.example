# Key: vault reference is the default; set a key or key file to override.
# OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=
# OPENROUTER_PASS_REF=pass://mac-mini/openrouter-macmini-video-to-text/API Key
# SUMMARY_API_KEY=
# SUMMARY_API_KEY_FILE=

# Summary (defaults shown).
SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
# SUMMARY_REASONING_EFFORT=high
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Recording.
# MEETING_LANGUAGE=en
# MEETREC_BIN=

# Local transcription (MOSS-Transcribe-Diarize, downloaded on first run).
# MOSS_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize
# MOSS_DEVICE=auto
# MOSS_REVISION=
# MOSS_CACHE_DIR=
