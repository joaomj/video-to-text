# Required: OpenRouter key for meeting summaries.
# Prefer the Proton Pass vault reference (default); set a key or key file to override.
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_FILE=
# OPENROUTER_PASS_REF=pass://mac-mini/openrouter-macmini-video-to-text/API Key

# Optional overrides (defaults shown).
SUMMARY_MODEL=deepseek/deepseek-v4.1-flash-1017
# MEETING_LANGUAGE=en

# Local transcription (MOSS-Transcribe-Diarize, Apache 2.0, downloaded on first run).
# MOSS_DEVICE=auto  (auto picks CUDA, Apple GPU, then CPU; or set cuda, mps, cpu)
# MOSS_REVISION=  (pins the model revision for remote-code safety)

# File-based secret variants.
SUMMARY_API_KEY_FILE=
