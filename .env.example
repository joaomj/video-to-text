# Summary (defaults shown). Served by llama-server on this Mac.
SUMMARY_MODEL=Qwen3.5-9B
LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_HF_REPO=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# LLM_CTX_SIZE=32768
# LLAMA_SERVER_BIN=

# Recording.
# MEETING_LANGUAGE=en
# MEETREC_BIN=

# Transcription. Default engine is the speech CLI (MOSS through MLX).
# ASR_ENGINE=speech
# SPEECH_MODEL=int5
# SPEECH_BACKEND=mlx
# SPEECH_BIN=

# Fallback engine (ASR_ENGINE=torch, needs torch and ~2.5x memory).
# MOSS_MODEL_ID=OpenMOSS-Team/MOSS-Transcribe-Diarize
# MOSS_DEVICE=auto
# MOSS_REVISION=
# MOSS_CACHE_DIR=
